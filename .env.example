# Copy to .env and fill in. NEVER commit .env.
RPC_URL_LOCAL=http://127.0.0.1:8545     # plain `anvil`, no fork needed
RPC_URL_SEPOLIA=                        # public RPC URL or a free provider key
ACTIVE_NETWORK=local                    # local | sepolia
WALLET_PRIVATE_KEY=                     # LOCAL only: anvil account #0 (public test key)
SEPOLIA_PRIVATE_KEY=                    # Sepolia only: a fresh throwaway from `cast wallet new` (never a real-money key)
ATTACKER_PRIVATE_KEY=                   # anvil account #1 (local attack replay only)
APPROVAL_SECRET=                        # random 32+ chars, shared by Person 1 and Person 2 via .env only
TOKEN_ADDRESS=                          # TestUSD address after deploy
# LLM: any OpenAI-compatible provider. Switch provider by changing these 3 lines only.
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_MODEL=                              # model name for that provider (fill in yourself)
LLM_API_KEY=                            # your key (fill in yourself; never commit, never share)
