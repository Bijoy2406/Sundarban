# secrets: NEVER commit
.env
*.key
*.pem

# python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# foundry / node
out/
cache/
broadcast/
node_modules/
dist/

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# local logs (the evidence/ folder is committed on purpose)
*.log
logs/
*.lock
*.plock

# raw test-output dumps must never be committed (pytest tries to collect test_*.txt files and aborts)
test_report*.txt
test_results*.txt

# graphify knowledge-graph output (local only)
graphify-out/

# keep the pinned dependency list although *.lock is ignored
!requirements.lock
